{
  "slug": "woocommerce",
  "title": "WooCommerce",
  "description": "The world's most popular open-source e-commerce platform, built as a WordPress plugin to turn any WordPress site into a fully featured online store.",
  "source": "https://github.com/woocommerce/woocommerce",
  "website": "https://woocommerce.com/",
  "icon": "https://raw.githubusercontent.com/stackblaze/stack-templates/main/services/woocommerce/icon.png",
  "categories": [
    "e-commerce",
    "cms",
    "work"
  ],
  "installation": "Runs the official wordpress image (PHP/Apache) with WooCommerce 11.1.1 pre-installed into wp-content/plugins and auto-activated after the WordPress install wizard. WordPress requires MySQL/MariaDB (not PostgreSQL), so the mariadb add-on is shipped. First run: complete the WordPress install wizard; WooCommerce activates on the next request and opens its store setup (address, currency, payment, shipping). Rotate the MariaDB password and all eight WORDPRESS_AUTH_KEY/SALT secrets before production. WP_HOME/WP_SITEURL follow the request host. Persistent data (plugins incl. WooCommerce, themes, uploads) lives on the mounted volume at /var/www/html/wp-content. Platform Email routes order receipts through SMTP_*; for payments add a gateway plugin (Stripe/PayPal).",
  "screenshots": [],
  "links": [
    "https://woocommerce.com/documentation/",
    "https://hub.docker.com/_/wordpress"
  ],
  "license": "GNU General Public License v3.0",
  "spdx_id": "GPL-3.0",
  "stars": 9400,
  "language": "PHP",
  "image": {
    "repository": "docker.io/library/wordpress",
    "tag": "7.1.0-php8.3-apache",
    "containerPort": "80",
    "command": []
  },
  "envVars": [
    {
      "name": "WORDPRESS_DB_HOST",
      "value": "$(MYSQL_HOST)"
    },
    {
      "name": "WORDPRESS_DB_NAME",
      "value": "$(MYSQL_DATABASE)"
    },
    {
      "name": "WORDPRESS_DB_USER",
      "value": "$(MYSQL_USER)"
    },
    {
      "name": "WORDPRESS_DB_PASSWORD",
      "value": "$(MYSQL_PASSWORD)"
    },
    {
      "name": "WORDPRESS_TABLE_PREFIX",
      "value": "wp_"
    },
    {
      "name": "WORDPRESS_CONFIG_EXTRA",
      "value": "define('WP_HOME', 'https://' . $_SERVER['HTTP_HOST']); define('WP_SITEURL', 'https://' . $_SERVER['HTTP_HOST']);"
    },
    {
      "name": "WORDPRESS_AUTH_KEY",
      "value": "{{KUBERO_GEN_ALNUM:64}}"
    },
    {
      "name": "WORDPRESS_SECURE_AUTH_KEY",
      "value": "{{KUBERO_GEN_ALNUM:64}}"
    },
    {
      "name": "WORDPRESS_LOGGED_IN_KEY",
      "value": "{{KUBERO_GEN_ALNUM:64}}"
    },
    {
      "name": "WORDPRESS_NONCE_KEY",
      "value": "{{KUBERO_GEN_ALNUM:64}}"
    },
    {
      "name": "WORDPRESS_AUTH_SALT",
      "value": "{{KUBERO_GEN_ALNUM:64}}"
    },
    {
      "name": "WORDPRESS_SECURE_AUTH_SALT",
      "value": "{{KUBERO_GEN_ALNUM:64}}"
    },
    {
      "name": "WORDPRESS_LOGGED_IN_SALT",
      "value": "{{KUBERO_GEN_ALNUM:64}}"
    },
    {
      "name": "WORDPRESS_NONCE_SALT",
      "value": "{{KUBERO_GEN_ALNUM:64}}"
    }
  ],
  "addons": [
    {
      "type": "mariadb",
      "name": "woocommerce",
      "db": "woocommerce",
      "user": "woocommerce",
      "password": "woocommerce"
    }
  ],
  "extraVolumes": [
    {
      "mountPath": "/var/www/html/wp-content",
      "name": "woocommerce-data",
      "size": "5Gi"
    }
  ]
}
