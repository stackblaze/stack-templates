{
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "login": {
    "path": "/auth/login",
    "steps": [
      { "waitForSelector": "input[name=username]" },
      { "fill": { "input[name=username]": "${METABASE_EMAIL}" } },
      { "fill": { "input[name=password]": "${METABASE_PASSWORD}" } },
      { "click": "button:has-text(\"Sign in\")" },
      { "waitForNavigation": true }
    ],
    "waitAfterMs": 2500
  },
  "pages": [
    { "name": "dashboard", "path": "/dashboard/1", "waitMs": 9000 },
    { "name": "question", "path": "/question/40", "waitMs": 6000,
      "steps": [ { "optionalClick": "role=button[name=/Start exploring/]" } ] },
    { "name": "sql", "path": "/question/41", "waitMs": 6000,
      "steps": [ { "click": "text=/open editor/i" } ] }
  ]
}
