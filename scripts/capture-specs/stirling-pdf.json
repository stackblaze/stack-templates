{
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "login": {
    "path": "/login",
    "steps": [
      { "waitForSelector": "#email", "timeout": 60000 },
      { "fill": { "#email": "admin" } },
      { "fill": { "#password": "${STIRLING_PDF_PASSWORD}" } },
      { "click": "button:has-text('Login')" },
      { "waitForSelector": "text=PDF Tools", "timeout": 30000 }
    ],
    "waitAfterMs": 2000
  },
  "pages": [
    { "name": "editor", "path": "/editor", "waitFor": "text=PDF Tools", "waitMs": 2500 }
  ],
  "note": "The catalog stills need files in the workbench: use scripts/seed-stirling-pdf-and-capture.mjs (capture-lib has no upload step)."
}
