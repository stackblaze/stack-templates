{
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "login": {
    "path": "/login",
    "steps": [
      { "waitForSelector": "#user", "timeout": 60000 },
      { "fill": { "#user": "${NEXTCLOUD_USER}" } },
      { "fill": { "#password": "${NEXTCLOUD_PASSWORD}" } },
      { "press": { "selector": "#password", "key": "Enter" } },
      { "sleep": 4000 },
      { "optionalClick": "button:has-text(\"Skip\")" },
      { "optionalClick": "[aria-label=Close]" }
    ],
    "waitAfterMs": 2000
  },
  "pages": [
    {"name": "files", "path": "/apps/files/files?dir=/", "waitMs": 3500},
    {"name": "folder", "path": "/apps/files/files?dir=/Projects/Website%20relaunch", "waitMs": 3500},
    {"name": "calendar", "path": "/apps/calendar/timeGridWeek/now", "waitMs": 3500}
  ]
}
