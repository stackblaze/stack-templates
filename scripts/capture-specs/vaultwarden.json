{
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "login": {
    "path": "/#/login",
    "steps": [
      {
        "waitForSelector": "input[type=email]",
        "timeout": 60000
      },
      {
        "fill": {
          "input[type=email]": "${VAULTWARDEN_EMAIL}"
        }
      },
      {
        "click": "role=button[name=/^\\s*Continue\\s*$/]"
      },
      {
        "waitForSelector": "input[type=password]",
        "timeout": 30000
      },
      {
        "fill": {
          "input[type=password]": "${VAULTWARDEN_PASSWORD}"
        }
      },
      {
        "click": "role=button[name=/^\\s*Log in\\s*$/]"
      },
      {
        "sleep": 5000
      },
      {
        "optionalClick": "text=Add it later"
      },
      {
        "optionalClick": "text=Skip to web app"
      },
      {
        "sleep": 1500
      }
    ],
    "waitAfterMs": 1000
  },
  "pages": [
    {
      "name": "vault",
      "path": "/#/vault",
      "waitFor": "text=Team wiki",
      "waitMs": 2000,
      "steps": [
        {
          "optionalClick": "role=button[name=/^\\s*Skip\\s*$/]"
        },
        {
          "sleep": 800
        },
        {
          "optionalClick": "text=Dismiss this checklist"
        },
        {
          "sleep": 1500
        },
        {
          "optionalClick": "bit-callout button[aria-label=\"Close\"]"
        }
      ]
    },
    {
      "name": "generator",
      "path": "/#/tools/generator",
      "waitMs": 1500,
      "steps": [
        {
          "waitForSelector": "bit-toggle label:has-text(\"Passphrase\")"
        },
        {
          "optionalClick": "bit-callout button[aria-label=\"Close\"]"
        },
        {
          "click": "bit-toggle label:has-text(\"Passphrase\")"
        },
        {
          "sleep": 1500
        }
      ]
    },
    {
      "name": "item",
      "path": "/#/vault",
      "waitFor": "text=Team wiki",
      "waitMs": 1500,
      "steps": [
        {
          "click": ":is(a,button):has-text(\"Team wiki\")"
        },
        {
          "waitForSelector": "text=Login credentials",
          "timeout": 15000
        },
        {
          "click": "button[aria-label=\"Toggle visibility\"]"
        },
        {
          "sleep": 1200
        }
      ]
    }
  ]
}
