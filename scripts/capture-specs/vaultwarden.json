{
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "login": {
    "path": "/#/login",
    "steps": [
      {
        "waitForSelector": "input[type=email]",
        "timeout": 60000
      },
      {
        "fill": {
          "input[type=email]": "${VAULTWARDEN_EMAIL}"
        }
      },
      {
        "click": "button:has-text(\"Continue\")"
      },
      {
        "waitForSelector": "input[type=password]",
        "timeout": 30000
      },
      {
        "fill": {
          "input[type=password]": "${VAULTWARDEN_PASSWORD}"
        }
      },
      {
        "click": "role=button[name=/^Log in$/]"
      },
      {
        "waitForSelector": "text=Add it later",
        "timeout": 30000
      },
      {
        "click": "text=Add it later"
      },
      {
        "waitForSelector": "text=Skip to web app",
        "timeout": 15000
      },
      {
        "click": "text=Skip to web app"
      },
      {
        "sleep": 3000
      },
      {
        "optionalClick": "role=button[name=/^\\s*Skip\\s*$/]",
        "timeout": 4000
      },
      {
        "optionalClick": "[data-testid=bit-banner-close-btn]"
      },
      {
        "optionalClick": "bit-callout button[aria-label=Close]"
      }
    ],
    "waitAfterMs": 2000
  },
  "pages": [
    {
      "name": "vault",
      "path": "/#/vault",
      "waitMs": 3500,
      "steps": [
        {
          "sleep": 1500
        },
        {
          "optionalClick": "role=button[name=/^\\s*Skip\\s*$/]",
          "timeout": 4000
        },
        {
          "optionalClick": "[data-testid=bit-banner-close-btn]"
        },
        {
          "optionalClick": "bit-callout button[aria-label=Close]"
        },
        {
          "sleep": 1500
        }
      ]
    },
    {
      "name": "generator",
      "path": "/#/tools/generator",
      "waitMs": 2500,
      "steps": [
        {
          "sleep": 1500
        },
        {
          "optionalClick": "role=button[name=/^\\s*Skip\\s*$/]",
          "timeout": 4000
        },
        {
          "optionalClick": "[data-testid=bit-banner-close-btn]"
        },
        {
          "optionalClick": "bit-callout button[aria-label=Close]"
        },
        {
          "sleep": 1500
        }
      ]
    }
  ]
}
