{
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "login": {
    "path": "/dashboard",
    "steps": [
      { "waitForSelector": "#floatingInput", "timeout": 60000 },
      { "fill": { "#floatingInput": "admin" } },
      { "fill": { "#floatingPassword": "${UPTIME_KUMA_ADMIN_PASSWORD}" } },
      { "click": "button[type=submit]" },
      { "waitForSelector": ".monitor-list .item", "timeout": 30000 }
    ],
    "waitAfterMs": 2000
  },
  "pages": [
    { "name": "dashboard-app", "path": "/dashboard", "waitFor": ".monitor-list .item", "waitMs": 1500,
      "steps": [
        { "click": ".monitor-list a:has-text(\"StackBlaze website\")" },
        { "waitForSelector": "[data-testid=monitor-status]", "timeout": 30000 },
        { "sleep": 2500 }
      ] },
    { "name": "status-page", "path": "/status/status", "waitFor": "text=All Systems Operational", "waitMs": 2500 },
    { "name": "add-monitor", "path": "/add", "waitFor": "#type", "waitMs": 2000 }
  ]
}
